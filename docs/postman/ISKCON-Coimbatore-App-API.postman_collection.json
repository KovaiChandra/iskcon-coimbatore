    {
      "name": "3. Donations",
      "item": [
        {
          "name": "Start donation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "x-api-key",
                "value": "{{apiKey}}",
                "description": "Only needed when the server sets APP_API_KEY"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/donations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "donations"
              ]
            },
            "description": "Creates the donation and a payment session. Saves {{reference}} and {{paymentUrl}}. PRODUCTION TAKES REAL MONEY when you open paymentUrl and pay.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"seva\": \"{{sevaSlug}}\",\n  \"amount\": 1,\n  \"fullName\": \"Prabhupada Dasa\",\n  \"mobile\": \"9876543210\",\n  \"email\": \"prabhupada.dasa@example.com\",\n  \"frequency\": \"one-time\",\n  \"occasion\": \"Birthday\",\n  \"pan\": \"\",\n  \"address\": \"\",\n  \"pin\": \"\",\n  \"consent\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is ' + pm.response.code, () => pm.expect(pm.response.code).to.be.oneOf([200, 201]));",
                  "const d = pm.response.json();",
                  "if (d.reference) pm.collectionVariables.set('reference', d.reference);",
                  "if (d.paymentUrl) pm.collectionVariables.set('paymentUrl', d.paymentUrl);",
                  "console.log('Open this to pay:', d.paymentUrl || '(online payment not available: ' + d.offlineReason + ')');"
                ]
